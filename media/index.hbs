<!-- media/index.hbs -->

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>ChromaSkin: Generate</title>
		<link rel="stylesheet" href="{{stylesUri}}" />
	</head>
	<body>
		<div class="main-container">
            <div class="container">
                <div class="header">
                    <h2>ChromaSkin</h2>
                    <p>Create a custom VS Code theme by selecting colors and adjusting intensity settings.</p>
                </div>

                <div class="settings-container">
                    <!-- Basic Settings Column -->
                    <div class="settings-column">
                        <div class="section-header"><hr><h3>Basic Settings</h3></div>
                    
                        <div class="color-picker-container">
                            <input type="color" id="color1" value="{{primary}}" />
                            <label for="color1">Primary Color</label>
                        </div>

                        <div class="color-picker-container">
                            <input type="color" id="color2" value="{{background}}" />
                            <label for="color2">Background Color</label>
                        </div>

                        <div class="color-picker-container">
                            <input type="color" id="color3" value="{{accent}}" />
                            <label for="color3">Accent Color</label>
                        </div>

                        <div class="color-picker-container">
                            <input type="color" id="color4" value="{{foreground}}" />
                            <label for="color4">Foreground Color</label>
                        </div>

                        <div class="color-picker-container">
                            <input type="color" id="color5" value="{{border}}" />
                            <label for="color5">Border Color</label>
                        </div>
                    </div>

                    <!-- Advanced Settings Column -->
                    <div class="settings-column">
                        <div class="section-header"><hr><h3>Advanced Settings</h3></div>

                        <div class="checkbox-container">
                            <input type="checkbox" id="autoAdvancedColors" {{#if autoAdvancedColors}}checked{{/if}} />
                            <label for="autoAdvancedColors">Automatic Colors</label>
                        </div>

                        <div id="advanced-colors-container" class="advanced-colors-container">
                            <div class="color-picker-container">
                                <input type="color" id="activityBarColor" value="{{activityBar}}" />
                                <label for="activityBarColor">Activity Bar Color</label>
                            </div>

                            <div class="color-picker-container">
                                <input type="color" id="popoverColor" value="{{popover}}" />
                                <label for="popoverColor">Popover Color</label>
                            </div>

                            <div class="color-picker-container">
                                <input type="color" id="buttonColor" value="{{button}}" />
                                <label for="buttonColor">Button Color</label>
                            </div>

                            <div class="color-picker-container">
                                <input type="color" id="indicatorColor" value="{{indicator}}" />
                                <label for="indicatorColor">Indicator Color - Tab + Activity Bar</label>
                            </div>
                        </div>

                        <!-- Optional Editor Foreground -->
                        <div class="optional-color-picker-container" data-setting-name="optionalEditorForeground">
                            <div class="checkbox-container optional-toggle-container">
                                {{!-- Checkbox to enable/disable custom color --}}
                                <input type="checkbox" id="optionalEditorForeground-default-toggle" class="optional-toggle" {{#if (eq optionalEditorForeground "default")}}checked{{/if}} />
                                <label for="optionalEditorForeground-default-toggle">Use Default Editor Foreground</label>
                            </div>
                            <div class="color-picker-container optional-input-container">
                                {{!-- The actual color input --}}
                                <input type="color" id="optionalEditorForeground" class="optional-color-input" value="{{#unless (eq optionalEditorForeground "default")}}{{optionalEditorForeground}}{{else}}#808080{{/unless}}" />
                                <label for="optionalEditorForeground">Editor Foreground</label>
                            </div>
                        </div>

                        <div class="checkbox-container">
                            <input type="checkbox" id="coloredCursor" {{#if coloredCursor}}checked{{/if}} />
                            <label for="coloredCursor">Colored Cursor</label>
                        </div>

                        <div class="checkbox-container">
                            <input type="checkbox" id="editorHighlighting" {{#if editorHighlighting}}checked{{/if}} />
                            <label for="editorHighlighting">Editor Highlighting Overwrite</label>
                        </div>

                        <div class="checkbox-container">
                            <input type="checkbox" id="syntaxCommentsOverwrite" {{#if syntaxCommentsOverwrite}}checked{{/if}} />
                            <label for="syntaxCommentsOverwrite">Syntax Comments Overwrite</label>
                        </div>

                        <div class="slider-container">
                            <input type="range" id="intensity" min="1" max="100" value="{{borderOpacity}}" />
                            <label for="intensity">Popever Border Strength</label>
                            <div class="slider-value" id="intensity-value">{{borderOpacity}}</div>
                        </div>

                        <div class="slider-container">
                            <input type="range" id="commentOpacity" min="1" max="10" value="{{commentOpacity}}" />
                            <label for="commentOpacity">Custom Comment Opacity</label>
                            <div class="slider-value" id="commentOpacity-value">{{commentOpacity}}</div>
                        </div>
                    </div>
                </div>

                <div class="footer">
                    {{!-- info message --}}
                    <div class="info-message warning" {{#if hideInfoMessage}}style="display:none;"{{/if}}>
                        <span class="warning-icon">⚠️</span>
                        <p>This extension modifies VS Code's workbench and token color customization settings. If you have existing custom color settings, they may be overwritten when applying a theme. If you haven't customized these settings before, this won't affect you.</p>
                        <button id="info-message-close" class="info-message-close" aria-label="Close warning message">×</button>
                    </div>
                    {{!-- button container --}}
                    <div class="button-container">
                        <button id="apply-button" class="apply-button">Apply Theme</button>
                        <button id="reset-button" class="reset-button">Clear</button>
                        <div class="dropdown-menu-container">
                            <button id="menu-button" class="menu-button">⋯</button>
                            <div id="dropdown-menu" class="dropdown-menu">
                                <div class="dropdown-menu-item" id="export-file">
                                    <span>Export to file</span>
                                </div>
                                <div class="dropdown-menu-item" id="copy-clipboard">
                                    <span>Copy to clipboard</span>
                                </div>
                                <div class="dropdown-menu-separator"></div>
                                <div class="dropdown-menu-item" id="import-file">
                                    <span>Import from file</span>
                                </div>
                                <div class="dropdown-menu-item" id="import-clipboard">
                                    <span>Import from clipboard</span>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="import-file-input" accept=".json" style="display: none;" />
                    </div>
                </div>
            </div>

            <!-- Add predefined themes section -->
            <div class="predefined-themes-container">
                <div class="sub-header">
                    <h2>Predefined Themes</h2>
                    <p>Choose a predefined theme to get started.</p>
                </div>
                <div class="theme-categories">
                    {{#each themes}}
                    <div class="theme-category">
                        <div class="category-header">{{@key}}</div>
                        <div class="theme-list">
                            {{#each this}}
                            <div class="theme-item" data-theme-category="{{@../key}}" data-theme-index="{{@index}}">
                                <div class="theme-name">{{this.name}}</div>
                                <div class="theme-description">{{this.description}}</div>
                                <div class="theme-preview">
                                    <div class="preview-color" style="background-color: {{this.config.primary}}"></div>
                                    <div class="preview-color" style="background-color: {{this.config.background}}"></div>
                                    <div class="preview-color" style="background-color: {{this.config.accent}}"></div>
                                    <div class="preview-color" style="background-color: {{this.config.foreground}}"></div>
                                    <div class="preview-color" style="background-color: {{this.config.border}}"></div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <!-- Modal for pasting JSON -->
            <div id="import-modal-overlay" class="modal-overlay">
                <div class="modal">
                    <h3 class="modal-title">Paste Theme JSON</h3>
                    <textarea id="import-json-textarea" placeholder="Paste your theme JSON here..."></textarea>
                    <div class="modal-buttons">
                        <button id="import-modal-apply" class="apply-button">Apply</button>
                        <button id="import-modal-cancel" class="secondary-button">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

		<script src="{{scriptUri}}"></script>
	</body>
</html>