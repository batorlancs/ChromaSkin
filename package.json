{
	"icon": "resources/chromaskin.png",
	"name": "chromaskin-by-bator",
	"displayName": "ChromaSkin",
	"description": "Mix & Match VS Code Syntax Highlighting with Custom UI",
	"version": "1.1.3",
	"publisher": "GergelyBator",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/batorlancs/ChromaSkin.git"
	},
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "chromaskin.openThemeGenerator",
				"title": "ChromaSkin: Open Theme Generator"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "20.x",
		"@types/vscode": "^1.96.0",
		"@typescript-eslint/eslint-plugin": "^8.17.0",
		"@typescript-eslint/parser": "^8.17.0",
		"@vscode/test-cli": "^0.0.10",
		"@vscode/test-electron": "^2.4.1",
		"eslint": "^9.16.0",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"handlebars": "^4.7.8"
	},
	"author": "Gergely Bator",
	"keywords": [
		"vscode",
		"theme"
	],
	"homepage": "https://github.com/batorlancs/ChromaSkin#readme"
}
